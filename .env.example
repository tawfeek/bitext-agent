# Nebius Token Factory credentials
# Sign up at https://studio.nebius.com and create an API key.
NEBIUS_API_KEY=your_key_here

# OpenAI-compatible base URL for Nebius Token Factory
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/

# Primary model used by the agent (Nebius model ID).
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B

# Max ReAct iterations before the agent emits a graceful fallback.
AGENT_MAX_ITERATIONS=12
